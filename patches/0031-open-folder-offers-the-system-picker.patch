+	/**
+	 * The dialog below types a path into the app's own storage. On Android that is never where
+	 * the user's code lives: the workspace is on public storage and any other folder comes from
+	 * the system picker, which grants access to it. So always run the picker, with no question
+	 * and no way into the typed dialog. Resolves true once the picker has been started.
+	 */
+	private async openFolderFromDevice(): Promise<boolean> {
+		if (!CommandsRegistry.getCommand(OPEN_FOLDER_FROM_DEVICE)) {
+			return false; // an unregistered id would make executeCommand wait for activation
+		}
+
+		try {
+			await this.commandService.executeCommand(OPEN_FOLDER_FROM_DEVICE);
+			return true;
+		} catch (error) {
+			// A picker that cannot be started must not leave Open Folder with no dialog at all.
+			this.logService.warn('[FileDialogService] Open Folder from Device failed, using the path dialog', error);
+			return false;
+		}
+	}
